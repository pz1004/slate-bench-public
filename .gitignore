# The repository publishes the implementation and its results only. Everything at the top
# level is ignored unless it is listed here, so `paper/` (the manuscript, its generated numbers,
# tables and figures, and its working documents), local notes and environments stay out of it.
# Add a `!/name` line for a new top-level path.
/*
!/.gitignore
!/.gitattributes
!/CITATION.cff
!/LICENSE
!/Makefile
!/README.md
!/pyproject.toml
!/requirements.txt
!/analysis-output/
!/configs/
!/data/
!/docs/
!/scripts/
!/src/
!/tests/

# Python caches and build files
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Manuscript checks, which need the manuscript
/scripts/static_latex_check.py
/tests/test_static_latex_check.py

# Outputs: the v2 runs and the compact check's stored training results, without smoke runs,
# per-split resume caches, the coverage study's per-replicate parts (its assembled CSVs are
# published) and run logs
/analysis-output/*
!/analysis-output/v2/
/analysis-output/v2/smoke/
/analysis-output/**/split_parts/
/analysis-output/v2/calibration_study/parts/
/analysis-output/**/logs/

# Inputs: the TabArena copies, not the local OpenML parquet cache
/data/*
!/data/tabarena/
/data/tabarena/*
!/data/tabarena/df_results.csv
!/data/tabarena/tabarena_dataset_metadata.csv
!/data/tabarena/NOTICE.md
!/data/tabarena/LICENSE-tabarena_dataset_curation.txt

# Documentation: the meta-study records, the claim template and the instrument coverage codes
/docs/*
!/docs/meta_study/
!/docs/claim_template.md
!/docs/positioning_coverage.csv
